<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <!-- Drop-off zones sized by car count: 7.5 m per car (car 5.0 m + minGap 2.5 m) -->
    <busStop id="bs_0" name="Z_MAIN_DS (SUMO-only, west of X1)" lane="31993796#5_1"    startPos="1.00"   endPos="31.00"/>   <!-- scenario opt: 4 cars (OPT_BS0_SPOTS=4), west of gate up to the Soi 13 merge -->
    <busStop id="bs_1" name="Z2Z3_L (curbSpots_L)" lane="31993796#4_1"    startPos="4.47"   endPos="34.47"/>  <!-- 4 cars, east of gate, left lane -->
    <!-- SCENARIO dynamic_dropoff v5: one continuous 60 m gate drop-off on the left lane (8 cars), measured back from
         the X1 stop line: bs_1 (0-30 m) + the P1 driveway stretch (30-48.9 m, painted below; SUMO cannot stop cars in
         a junction, so dynamic_dropoff.py holds them still there) + bs_1x (48.9-60 m) east of P1.
         Only opened as the drop-off queue grows (dynamic_dropoff.py); no car is routed to bs_1x directly. -->
    <busStop id="bs_1x" name="Z2Z3_L extension (dynamic, east of P1)" lane="31993796#3_1" startPos="20.70" endPos="31.77"/>
    <poly id="gate_dropoff_P1_stretch" type="dropoff_zone" color="76,170,50" fill="1" layer="12"
          shape="294.12,189.96 279.91,192.34 275.49,193.00 275.05,190.24 279.47,189.58 293.68,187.20"/>  <!-- curb side of the left lane like the bus-stop bands: #3_1 end -> P1 junction -> bs_1 start -->
    <busStop id="bs_5" name="Z2Z3_R (curbSpots_R)" lane="31993796#4_2"    startPos="4.47"   endPos="34.47"/>  <!-- 4 cars, east of gate, right lane -->
    <busStop id="bs_2" name="Z1 (curbSpots2_L, DROPOFF_SECOND)" lane="31973416#1_1"    startPos="0.15"   endPos="28.15"/>   <!-- 4 cars, Soi 11 before X2 -->
    <busStop id="bs_4" name="Z1_DS (SUMO-only, south of X2)" lane="31973416#1.32_1" startPos="4.66"   endPos="34.66"/>   <!-- 4 cars, Soi 11 after X2 -->
</additional>


